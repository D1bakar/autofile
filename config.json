{
  "watch_path": "C:\\Users\\Sayantan\\Desktop\\Developer",
  "output_dir": "_sorted",
  "settle_seconds": 2,
  "rules": {
    "images": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tif", ".tiff", ".heic", ".svg", ".ico"],
    "documents": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".md", ".rtf", ".odt", ".csv", ".epub"],
    "archives": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz"],
    "installers": [".exe", ".msi", ".msix", ".apk"],
    "media": [".mp3", ".wav", ".flac", ".ogg", ".mp4", ".mkv", ".mov", ".avi", ".webm"],
    "code": [".py", ".js", ".ts", ".jsx", ".tsx", ".css", ".html", ".sh", ".ps1", ".bat", ".ipynb", ".json", ".yml", ".yaml", ".toml"]
  },
  "ignore_names": ["autofile", "_sorted", ".git", "node_modules", "__pycache__", ".venv", "venv"]
}
